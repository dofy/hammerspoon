#!/bin/zsh
# keystats — query the shortcut-usage database written by ~/.hammerspoon/keystats.lua
emulate -L zsh
set -euo pipefail

DB=${KEYSTATS_DB:-$HOME/.local/share/keystats/keystats.db}
SELF_DIR=${0:A:h}
TEMPLATE=${KEYSTATS_TEMPLATE:-$SELF_DIR/report.html}
SQLITE=/usr/bin/sqlite3

die() { print -u2 "keystats: $*"; exit 1 }
[[ -f $DB ]] || die "no database at $DB (is the Hammerspoon module running?)"

# --- time parsing -----------------------------------------------------------
# Accepts: all | today | yesterday | 7d | 24h | 90m | 4w | YYYY-MM-DD
epoch_of() {
  local v=$1
  case $v in
    ''|all)     print 0 ;;
    today)      date -v0H -v0M -v0S +%s ;;
    yesterday)  date -v-1d -v0H -v0M -v0S +%s ;;
    now)        date +%s ;;
    <->d)       date -v-${v%d}d +%s ;;
    <->w)       date -v-${v%w}w +%s ;;
    <->h)       date -v-${v%h}H +%s ;;
    <->m)       date -v-${v%m}M +%s ;;
    <->mo)      date -v-${v%mo}m +%s ;;
    ????-??-??) date -j -f '%Y-%m-%d %H:%M:%S' "$v 00:00:00" +%s ;;
    *)          die "cannot parse time '$v'" ;;
  esac
}

# --- dimension expressions --------------------------------------------------
MODSYM="replace(replace(replace(replace(replace(e.mods,'ctrl','⌃'),'alt','⌥'),'shift','⇧'),'cmd','⌘'),'+','')"
KEYLBL="CASE WHEN length(k.name)=1 THEN upper(k.name) ELSE k.name END"
LOCAL="'unixepoch','localtime'"

dim_expr() {
  case $1 in
    combo)     print "$MODSYM || $KEYLBL" ;;
    key)       print "$KEYLBL" ;;
    mods)      print "CASE WHEN e.mods='' THEN '(none)' ELSE $MODSYM END" ;;
    app)       print "a.name" ;;
    bundle)    print "a.bundle_id" ;;
    hour)      print "strftime('%Y-%m-%d %H:00', e.ts,$LOCAL)" ;;
    day)       print "strftime('%Y-%m-%d', e.ts,$LOCAL)" ;;
    week)      print "strftime('%Y-W%W', e.ts,$LOCAL)" ;;
    month)     print "strftime('%Y-%m', e.ts,$LOCAL)" ;;
    dow)       print "strftime('%w', e.ts,$LOCAL)" ;;
    hourofday) print "strftime('%H', e.ts,$LOCAL)" ;;
    *) die "unknown dimension '$1' (combo key mods app bundle hour day week month dow hourofday)" ;;
  esac
}

FROM="FROM event e
      JOIN app a          ON a.id = e.app_id
      LEFT JOIN keyname k ON k.keycode = e.keycode"

# --- shared option parsing --------------------------------------------------
sql_quote() { local v=${1-}; print -- "${v//\'/\'\'}" }

parse_opts() {
  SINCE=${KEYSTATS_SINCE:-7d}; UNTIL=now; APP=; MODS=; KEY=
  BY=combo; ROWS=app; COLS=mods; BUCKET=day; LIMIT=20; OUT=; OPEN=0; FROMFILE=; OLDER=
  PORT=8787; HOST=127.0.0.1
  while (( $# )); do
    case $1 in
      --since)  SINCE=$2; shift 2 ;;
      --until)  UNTIL=$2; shift 2 ;;
      --app)    APP=$2;   shift 2 ;;
      --mods)   MODS=$2;  shift 2 ;;
      --key)    KEY=$2;   shift 2 ;;
      --by)     BY=$2;    shift 2 ;;
      --rows)   ROWS=$2;  shift 2 ;;
      --cols)   COLS=$2;  shift 2 ;;
      --bucket) BUCKET=$2; shift 2 ;;
      --limit)  LIMIT=$2; shift 2 ;;
      --out)    OUT=$2;   shift 2 ;;
      --from)   FROMFILE=$2; shift 2 ;;
      --older-than) OLDER=$2; shift 2 ;;
      --port)   PORT=$2; shift 2 ;;
      --host)   HOST=$2; shift 2 ;;
      --open)   OPEN=1; shift ;;
      -*) die "unknown option $1" ;;
      *)  die "unexpected argument $1" ;;
    esac
  done
  TS_FROM=$(epoch_of $SINCE); TS_TO=$(epoch_of $UNTIL)
  WHERE="e.ts >= $TS_FROM AND e.ts <= $TS_TO"
  if [[ -n $APP   ]]; then WHERE+=" AND (a.name LIKE '%$(sql_quote "$APP")%' OR a.bundle_id LIKE '%$(sql_quote "$APP")%')"; fi
  if [[ -n $MODS  ]]; then WHERE+=" AND e.mods = '$(sql_quote "$MODS")'"; fi
  if [[ -n $KEY   ]]; then WHERE+=" AND k.name = '$(sql_quote "$KEY")'"; fi
  return 0
}

# --- commands ---------------------------------------------------------------
cmd_status() {
  $SQLITE -box "$DB" "
    SELECT (SELECT count(*) FROM event)                                   AS event_rows,
           (SELECT coalesce(sum(n),0) FROM event)                         AS keypresses,
           (SELECT count(*) FROM app)                                     AS apps,
           (SELECT strftime('%Y-%m-%d %H:%M', min(ts),$LOCAL) FROM event) AS first_event,
           (SELECT strftime('%Y-%m-%d %H:%M', max(ts),$LOCAL) FROM event) AS last_event;"
  print "db: $DB  ($(du -h "$DB" | cut -f1))"
}

cmd_top() {
  parse_opts "$@"
  local d=$(dim_expr $BY)
  $SQLITE -box "$DB" "
    WITH agg AS (
      SELECT $d AS label, sum(e.n) AS n, count(DISTINCT a.id) AS apps,
             max(e.ts) AS last_ts
      $FROM WHERE $WHERE GROUP BY label
    ), m AS (SELECT max(n) AS mx, sum(n) AS total FROM agg)
    SELECT label AS \"$BY\", n,
           printf('%.1f%%', 100.0*n/m.total) AS pct,
           substr('██████████████████████████████',1,cast(round(30.0*n/m.mx) AS int)) AS bar,
           strftime('%m-%d %H:%M', last_ts,$LOCAL) AS last
    FROM agg, m ORDER BY n DESC LIMIT $LIMIT;"
}

cmd_pivot() {
  parse_opts "$@"
  local r=$(dim_expr $ROWS) c=$(dim_expr $COLS)
  # Column set is dynamic, so the pivot SQL is generated then executed.
  local cols=$($SQLITE "$DB" "
    SELECT group_concat(q,',') FROM (
      SELECT '''' || replace(label,'''','''''') || ''' AS col' AS q FROM (
        SELECT $c AS label, sum(e.n) AS n $FROM WHERE $WHERE
        GROUP BY label ORDER BY n DESC LIMIT 12))")
  local cases=$($SQLITE "$DB" "
    SELECT group_concat(q,', ') FROM (
      SELECT 'sum(CASE WHEN col = ''' || replace(label,'''','''''') || ''' THEN n ELSE 0 END) AS \"' || replace(label,'\"','') || '\"' AS q
      FROM (SELECT $c AS label, sum(e.n) AS n $FROM WHERE $WHERE
            GROUP BY label ORDER BY n DESC LIMIT 12))")
  [[ -n $cases ]] || die "no data in range"
  $SQLITE -box "$DB" "
    WITH base AS (SELECT $r AS row_label, $c AS col, sum(e.n) AS n
                  $FROM WHERE $WHERE GROUP BY row_label, col)
    SELECT row_label AS \"$ROWS\", $cases, sum(n) AS total
    FROM base GROUP BY row_label ORDER BY total DESC LIMIT $LIMIT;"
}

cmd_time() {
  parse_opts "$@"
  local d=$(dim_expr $BUCKET)
  $SQLITE -box "$DB" "
    WITH agg AS (SELECT $d AS bucket, sum(e.n) AS n, count(DISTINCT e.keycode||e.mods) AS combos
                 $FROM WHERE $WHERE GROUP BY bucket),
         m AS (SELECT max(n) AS mx FROM agg)
    SELECT bucket AS \"$BUCKET\", n, combos,
           substr('██████████████████████████████████████████',1,cast(round(42.0*n/m.mx) AS int)) AS bar
    FROM agg, m ORDER BY bucket;"
}

cmd_apps()   { parse_opts "$@"; BY=app;   cmd_top --since $SINCE --until $UNTIL --by app   --limit $LIMIT }
# Combos listed in FILE that were never used in the range — one combo per line,
# written the way the database stores modifiers: cmd+shift+p
cmd_unused() {
  parse_opts "$@"
  [[ -n $FROMFILE && -f $FROMFILE ]] || die "--from FILE required (one combo per line, e.g. cmd+shift+p)"
  print "unused since $SINCE:"
  local line mods key n
  while IFS= read -r line; do
    if [[ -z ${line// } || $line == \#* ]]; then continue; fi
    key=${line##*+}; mods=${line%+*}
    if [[ $mods == $key ]]; then mods=; fi
    n=$($SQLITE "$DB" "SELECT coalesce(sum(e.n),0) $FROM WHERE $WHERE AND e.mods='$(sql_quote "$mods")' AND k.name='$(sql_quote "$key")'")
    if (( n == 0 )); then print "  $line"; fi
  done < $FROMFILE
}

# A global hotkey is consumed before any app sees it, so the tap always credits
# whoever was frontmost. Three pieces of evidence narrow it down: an app
# activation recorded right after the keystroke (switch_to), how concentrated
# those activations are on one target, and how evenly the combination is spread
# over apps (normalised Shannon entropy — a per-app shortcut clusters in one
# app, a global one shows up everywhere).
#
# A single activation proves nothing: closing the frontmost window can bring
# another app forward on its own. So switch evidence only counts from
# MIN_SWITCH_HITS up, and a hotkey whose activations scatter over many targets
# is a switcher (cmd-tab) rather than a launcher for any one app.
cmd_global() {
  parse_opts "$@"
  local MIN_SWITCH_HITS=3 FOCUS_MIN=0.8
  local sym="replace(replace(replace(replace(replace(tot.mods,'ctrl','⌃'),'alt','⌥'),'shift','⇧'),'cmd','⌘'),'+','')"
  $SQLITE -box "$DB" "
    WITH ev AS (
      SELECT e.mods AS mods, e.keycode AS keycode, e.app_id AS app_id, sum(e.n) AS n
      $FROM WHERE $WHERE GROUP BY 1,2,3
    ), tot AS (
      SELECT mods, keycode, sum(n) AS total, count(*) AS apps FROM ev GROUP BY 1,2
    ), ent AS (
      SELECT ev.mods AS mods, ev.keycode AS keycode,
             -sum((1.0*ev.n/tot.total) * log2(1.0*ev.n/tot.total)) AS h
      FROM ev JOIN tot ON tot.mods = ev.mods AND tot.keycode = ev.keycode
      GROUP BY 1,2
    ), swx AS (
      SELECT e.mods AS mods, e.keycode AS keycode, e.switch_to AS target_id, sum(e.n) AS n
      FROM event e WHERE e.ts >= $TS_FROM AND e.ts <= $TS_TO AND e.switch_to IS NOT NULL
      GROUP BY 1,2,3
    ), sw AS (
      SELECT mods, keycode, sum(n) AS hits, count(*) AS targets, max(n) AS top_hits,
             (SELECT s.name FROM swx x2 JOIN app s ON s.id = x2.target_id
              WHERE x2.mods = swx.mods AND x2.keycode = swx.keycode
              ORDER BY x2.n DESC LIMIT 1) AS target
      FROM swx GROUP BY mods, keycode
    ), scale AS (SELECT max(2, count(DISTINCT e.app_id)) AS apps $FROM WHERE $WHERE)
    SELECT $sym || (CASE WHEN length(k.name)=1 THEN upper(k.name) ELSE k.name END) AS combo,
           tot.total AS n,
           tot.apps  AS apps,
           printf('%.2f', coalesce(ent.h,0) / log2(scale.apps)) AS spread,
           coalesce(sw.hits,0) AS switches,
           coalesce(sw.targets,0) AS targets,
           CASE WHEN sw.hits > 0 THEN printf('%.2f', 1.0*sw.top_hits/sw.hits) ELSE '—' END AS focus,
           CASE
             WHEN coalesce(sw.hits,0) >= $MIN_SWITCH_HITS
                  AND 1.0*sw.top_hits/sw.hits >= $FOCUS_MIN THEN '全局 → ' || sw.target
             WHEN coalesce(sw.hits,0) >= $MIN_SWITCH_HITS THEN '全局 · 切换类'
             WHEN tot.apps >= 4 AND coalesce(ent.h,0) / log2(scale.apps) >= 0.6 THEN '疑似全局'
             WHEN tot.apps = 1 THEN 'app 内'
             ELSE '不确定'
           END AS verdict
    FROM tot
    JOIN ent ON ent.mods = tot.mods AND ent.keycode = tot.keycode
    LEFT JOIN sw ON sw.mods = tot.mods AND sw.keycode = tot.keycode
    LEFT JOIN keyname k ON k.keycode = tot.keycode
    CROSS JOIN scale
    ORDER BY (coalesce(sw.hits,0) >= $MIN_SWITCH_HITS) DESC, tot.total DESC
    LIMIT $LIMIT;"
}

cmd_serve() {
  parse_opts "$@"
  print "keystats: live dashboard — Ctrl-C to stop"
  if (( OPEN )); then (sleep 1 && open "http://$HOST:$PORT") & fi
  exec /usr/bin/python3 "$SELF_DIR/server.py" --db "$DB" --template "$TEMPLATE" --host "$HOST" --port "$PORT"
}

cmd_prune() {
  parse_opts "$@"
  [[ -n $OLDER ]] || die "--older-than required, e.g. --older-than 90d"
  local cut=$(epoch_of $OLDER)
  print "rolling up events before $(date -r $cut '+%Y-%m-%d %H:%M') to hour granularity"
  $SQLITE "$DB" "
    BEGIN IMMEDIATE;
    CREATE TEMP TABLE rolled AS
      SELECT (ts/3600)*3600 AS ts, app_id, mods, keycode, sum(n) AS n
      FROM event WHERE ts < $cut GROUP BY 1,2,3,4;
    DELETE FROM event WHERE ts < $cut;
    INSERT INTO event(ts,app_id,mods,keycode,n) SELECT ts,app_id,mods,keycode,n FROM rolled;
    COMMIT;
    VACUUM;"
  cmd_status
}

cmd_sql() { [[ $# -ge 1 ]] || die "usage: keystats sql \"SELECT ...\""; $SQLITE -box "$DB" "$1" }

cmd_report() {
  parse_opts "$@"
  [[ -f $TEMPLATE ]] || die "template missing: $TEMPLATE"
  local out=${OUT:-${DB:h}/report.html}
  local tmp=$(mktemp -t keystats-data)

  # Bounded datasets; the page does all pivoting client-side.
  {
    print -n '{"meta":'
    $SQLITE -json "$DB" "
      SELECT '$SINCE' AS since, $TS_FROM AS ts_from, $TS_TO AS ts_to,
             coalesce(sum(e.n),0) AS total,
             count(DISTINCT e.mods||'/'||e.keycode) AS combos,
             count(DISTINCT a.id) AS apps,
             strftime('%Y-%m-%d %H:%M', min(e.ts),$LOCAL) AS first_event,
             strftime('%Y-%m-%d %H:%M', max(e.ts),$LOCAL) AS last_event
      $FROM WHERE $WHERE" | sed 's/^\[//; s/\]$//'
    print -n ',"combos":'
    $SQLITE -json "$DB" "
      SELECT a.name AS app, e.mods AS mods, k.name AS key, sum(e.n) AS n
      $FROM WHERE $WHERE GROUP BY 1,2,3 ORDER BY n DESC"
    print -n ',"timeline":'
    $SQLITE -json "$DB" "
      SELECT (e.ts/3600)*3600 AS h, a.name AS app, sum(e.n) AS n
      $FROM WHERE $WHERE GROUP BY 1,2 ORDER BY 1"
    print -n ',"switches":'
    $SQLITE -json "$DB" "
      SELECT e.mods AS mods, k.name AS key, s.name AS target, sum(e.n) AS n
      $FROM JOIN app s ON s.id = e.switch_to
      WHERE $WHERE GROUP BY 1,2,3 ORDER BY n DESC"
    print -n '}'
  } > $tmp

  # Substitute via a file read so no shell escaping of the JSON is needed.
  DATA_FILE=$tmp TEMPLATE=$TEMPLATE OUT=$out python3 -c '
import os
tpl = open(os.environ["TEMPLATE"]).read()
data = open(os.environ["DATA_FILE"]).read()
marker = "/*__KEYSTATS_DATA__*/null"
assert marker in tpl, "template lost its data marker"
open(os.environ["OUT"], "w").write(tpl.replace(marker, data))
'
  rm -f $tmp
  print "wrote $out"
  if (( OPEN )); then open "$out"; fi
}

usage() {
  cat <<'EOF'
keystats — shortcut usage statistics

  keystats status
  keystats top    [--by combo|key|mods|app|day|hour|dow] [--since 7d] [--app X] [--limit N]
  keystats pivot  --rows <dim> --cols <dim> [--since 30d] [--limit N]
  keystats time   [--bucket hour|day|week|month|dow|hourofday] [--since 30d] [--app X]
  keystats apps   [--since 7d] [--limit N]
  keystats unused --from FILE [--since 30d]
  keystats global [--since 30d] [--limit N]
  keystats serve  [--port 8787] [--open]
  keystats report [--since 30d] [--out FILE] [--open]
  keystats sql    "SELECT ..."
  keystats prune  --older-than 90d

`serve` is the live dashboard: it polls the database, so the numbers keep moving.
`report` writes a static snapshot of the same page.

Filters accepted by every query command: --since --until --app --mods --key
Time values: all | today | yesterday | now | 7d | 24h | 90m | 4w | 3mo | YYYY-MM-DD
Dimensions:  combo key mods app bundle hour day week month dow hourofday
EOF
}

cmd=${1:-help}; (( $# )) && shift || true
case $cmd in
  status) cmd_status "$@" ;;
  top)    cmd_top "$@" ;;
  pivot)  cmd_pivot "$@" ;;
  time)   cmd_time "$@" ;;
  apps)   cmd_apps "$@" ;;
  unused) cmd_unused "$@" ;;
  report) cmd_report "$@" ;;
  global) cmd_global "$@" ;;
  serve)  cmd_serve "$@" ;;
  prune)  cmd_prune "$@" ;;
  sql)    cmd_sql "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
